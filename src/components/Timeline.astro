---
// The red CV section. Content in data/content.ts (English only).
import { timeline } from '../data/content';
---
<section id="cv" class="cv section-space" lang="en">
	<div class="section-shell cv-inner">
		<div class="cv-title">
			<p class="kicker light">The short version</p>
			<h2>Experience,<br /><em>minus the<br />stiff PDF.</em></h2>
			<a class="button button-yellow" href="mailto:helena@holagato.se?subject=Full%20CV%20please">Ask for the full CV ↗︎</a>
		</div>
		<div class="timeline">
			{timeline.map((item) => (
				<div class:list={['timeline-item', { current: item.current }]}>
					<span>{item.when}</span>
					<div><h3>{item.title}</h3>{item.text && <p>{item.text}</p>}</div>
				</div>
			))}
		</div>
	</div>
</section>
