---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class:list={['logo-mark', className]}
	viewBox="0 0 64 56"
	aria-hidden="true"
	focusable="false"
>
	<path
		class="logo-mark__head"
		d="M10.5 20.5 7.5 5.5 23 14.2a31 31 0 0 1 18 0L56.5 5.5l-3 15c3.4 4.1 5 8.5 5 13.1C58.5 45 47.4 52 32 52S5.5 45 5.5 33.6c0-4.6 1.6-9 5-13.1Z"
	/>
	<path class="logo-mark__ear" d="m11.5 11.8 9.2 5.3-7.4 3.3Z" />
	<path class="logo-mark__ear" d="m52.5 11.8-9.2 5.3 7.4 3.3Z" />
	<path class="logo-mark__brow" d="M16.8 28.2c2.6-2.2 6.1-2.6 9-.8M47.2 28.2c-2.6-2.2-6.1-2.6-9-.8" />
	<ellipse class="logo-mark__eye" cx="22" cy="33.2" rx="2.3" ry="3.2" />
	<ellipse class="logo-mark__eye" cx="42" cy="33.2" rx="2.3" ry="3.2" />
	<path class="logo-mark__nose" d="m32 37.2-3.2 2.2L32 42l3.2-2.6Z" />
	<path class="logo-mark__mouth" d="M32 42v1.1c-1.5 2.5-4.3 3-6.2 1.5M32 43.1c1.5 2.5 4.3 3 6.2 1.5" />
	<path class="logo-mark__whiskers" d="M24.5 39.3 13.8 37M24 42.2l-10.5 1.4M39.5 39.3 50.2 37M40 42.2l10.5 1.4" />
</svg>

<style>
	.logo-mark {
		display: block;
		width: 42px;
		height: auto;
		overflow: visible;
		color: var(--logo-ink, #760031);
	}

	.logo-mark__head {
		fill: var(--logo-fill, #ff6060);
		stroke: currentColor;
		stroke-width: 3;
		stroke-linejoin: round;
	}

	.logo-mark__ear {
		fill: var(--logo-ear, #feec41);
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linejoin: round;
	}

	.logo-mark__brow,
	.logo-mark__mouth,
	.logo-mark__whiskers {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.logo-mark__eye,
	.logo-mark__nose {
		fill: currentColor;
	}
</style>
