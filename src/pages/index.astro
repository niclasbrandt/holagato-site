---
// HOME (English) – a short teaser of everything, with links to the subpages.
import PageLayout from '../layouts/PageLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import ServiceCards from '../components/ServiceCards.astro';
import AudienceGrid from '../components/AudienceGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CaseCard from '../components/CaseCard.astro';
import { featuredCases } from '../data/cases';
---
<PageLayout
	lang="en"
	page="home"
	title="Hola Gato – The lawyer who gets things off the ground"
	description="Independent legal strategy and change for leadership teams and lean legal teams – contracts, corporate matters, GDPR and AI, with the legal calls made along the way."
>
	<section class="hero section-shell">
		<div class="hero-copy">
			<p class="eyebrow"><span></span> A lawyer who’d rather build than block</p>
			<h1>The lawyer who gets things<br /><em>off the ground.</em></h1>
			<p class="hero-intro">Contracts, corporate matters, GDPR and AI. I bring the curiosity to ask the right questions, and the legal judgment to act on the answers – along the way, not after.</p>
			<div class="hero-actions">
				<a class="button button-dark" href="#contact">Tell me what’s up <span>↘︎</span></a>
				<a class="text-link" href="#services">See how I can help <span>↓︎</span></a>
			</div>
		</div>
		<HeroArt />
	</section>

	<div class="ticker" aria-hidden="true">
		<div>COMMERCIAL CONTRACTS <b>✦︎</b> CORPORATE <b>✦︎</b> GDPR <b>✦︎</b> AI GOVERNANCE <b>✦︎</b> NEGOTIATION <b>✦︎</b> LEGAL OPS <b>✦︎</b> CHANGE MANAGEMENT <b>✦︎</b></div>
	</div>

	<section id="services" class="services section-shell section-space">
		<div class="section-heading">
			<div><p class="kicker">What I do</p><h2>Start with<br /><em>your question.</em></h2></div>
			<p>These are the questions I hear most often. Find yours, and we know where to start.</p>
		</div>
		<ServiceCards lang="en" />
		<div class="section-more">
			<a class="button button-dark" href="/pricing">See pricing <span>↗︎</span></a>
		</div>
	</section>

	<AudienceGrid lang="en" />
	<Testimonials lang="en" />

	<section class="case-studies section-shell section-space">
		<div class="section-heading compact">
			<div><p class="kicker">Case studies</p><h2>Proof,<br /><em>not promises.</em></h2></div>
			<p>Two engagements that show how I work. More on the case studies page.</p>
		</div>
		<div class="case-featured-grid">
			{featuredCases.map((item) => <CaseCard item={item} featured />)}
		</div>
		<a class="more-link" href="/cases">See all case studies ↗︎</a>
	</section>
</PageLayout>

<script>
	// Old one-page links (holagato.se/#cv etc.) → the new subpages
	const moved: Record<string, string> = {
		'#about': '/about', '#cv': '/about#cv', '#case-studies': '/cases', '#who': '#who',
	};
	const target = moved[location.hash];
	if (target && target !== location.hash) location.replace(target);
</script>
