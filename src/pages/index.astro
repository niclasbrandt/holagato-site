---
import Layout from '../layouts/Layout.astro';
import LogoMark from '../components/LogoMark.astro';

const services = [
	{
		number: '01',
		title: 'Commercial contracts',
		text: 'Clear, workable agreements for customers, vendors, partnerships and everything in between.',
		tags: ['SaaS', 'Procurement', 'Negotiation'],
	},
	{
		number: '02',
		title: 'Privacy & data',
		text: 'Practical privacy support that fits your product, your team and the way your data actually moves.',
		tags: ['GDPR', 'DPA', 'Product advice'],
	},
	{
		number: '03',
		title: 'Legal for product teams',
		text: 'Legal thinking built into the process — from first sketch to launch day and beyond.',
		tags: ['AI', 'Digital products', 'Risk'],
	},
	{
		number: '04',
		title: 'Fractional legal counsel',
		text: 'Senior legal help when you need it, without making a full-time hire before the time is right.',
		tags: ['Scale-ups', 'Legal ops', 'Ongoing support'],
	},
];

const principles = [
	['Plain language', 'Advice should make the next move obvious. No legal fog, no twenty-page answer to a two-line question.'],
	['Close to the work', 'I plug into your team, learn the product and solve the problem with the people actually building it.'],
	['Right-sized risk', 'Not every risk is a red light. I help you see what matters, decide confidently and keep moving.'],
];
---

<Layout
	title="Hola Gato — Legal counsel for people building the future"
	description="Independent legal consulting for technology companies, product teams and growing businesses."
>
	<header class="site-header">
		<a class="logo" href="#top" aria-label="Hola Gato, back to top">
			<LogoMark />
			<span>hola gato</span>
		</a>
		<nav aria-label="Main navigation">
			<a href="#services">Services</a>
			<a href="#about">About</a>
			<a href="#cv">CV</a>
			<a href="#contact" class="nav-cta">Let’s talk <span>↗</span></a>
		</nav>
	</header>

	<main id="top">
		<section class="hero section-shell">
			<div class="hero-copy">
				<p class="eyebrow"><span></span> Independent legal consulting for tech</p>
				<h1>Legal advice<br />with <em>curiosity.</em></h1>
				<p class="hero-intro">Hola Gato helps ambitious tech companies make clear decisions, useful contracts and excellent products — without the legal theatre.</p>
				<div class="hero-actions">
					<a class="button button-dark" href="#contact">Tell me what’s up <span>↘</span></a>
					<a class="text-link" href="#services">See how I can help <span>↓</span></a>
				</div>
			</div>

			<div class="hero-art" aria-label="Illustration of a curious cat peeking into a legal document">
				<div class="orbit orbit-one"></div>
				<div class="orbit orbit-two"></div>
				<div class="legal-card">
					<div class="card-top"><span>LEGAL, BUT USEFUL</span><span>✦</span></div>
					<div class="card-lines"><i></i><i></i><i></i><i></i><i></i></div>
					<div class="approved">CLEAR<br />ENOUGH</div>
				</div>
				<svg class="hero-cat" viewBox="0 0 390 300" aria-hidden="true">
					<path class="cat-tail" d="M303 264c49-2 73-24 68-53-3-19-17-29-31-25-13 4-16 18-8 28"></path>
					<path class="cat-tail-fill" d="M303 264c49-2 73-24 68-53-3-19-17-29-31-25-13 4-16 18-8 28"></path>
					<path class="cat-body" d="M99 272c-4-45 13-78 54-98-11-24-10-49 1-70l29-53 38 39c20-5 42-3 60 5l46-34 2 61c14 17 19 38 13 60 16 24 17 59 3 90H99Z"></path>
					<path class="cat-ear" d="m171 93 13-27 22 25c-13 0-24 1-35 2Zm127 10 27-28 1 39c-8-5-17-9-28-11Z"></path>
					<path class="cat-chest" d="M208 270c4-23 18-36 39-36 22 0 37 13 42 36"></path>
					<path class="cat-muzzle" d="M217 186c7-8 17-10 28-4 10-5 20-3 27 5-1 20-10 31-27 31-18 0-27-11-28-32Z"></path>
					<path class="cat-eye-socket" d="M179 151c5-13 20-18 33-11 8 5 11 14 7 23-5 12-20 16-32 9-8-4-11-13-8-21Zm91 5c4-12 17-18 29-13 10 4 15 13 12 23-4 12-17 18-29 13-10-4-15-13-12-23Z"></path>
					<path class="cat-pupil" d="M202 145c5 1 8 6 7 12s-5 10-10 9-8-6-7-12 5-10 10-9Zm91 3c5 1 8 6 7 12s-5 10-10 9-8-6-7-12 5-10 10-9Z"></path>
					<path class="cat-nose" d="m245 183-8 5 8 7 8-7Z"></path>
					<path class="cat-detail" d="M245 195v5m0 0c-6 9-17 10-24 5m24-5c6 9 17 10 24 5M177 131c10-8 22-9 33-3m67 4c10-6 21-4 29 4"></path>
					<path class="cat-detail whiskers" d="m215 187-102-17m100 29-109 7m171-16 79-15m-77 27 86 14"></path>
					<path class="cat-freckles" d="M208 184h.01m-8 5h.01m89-1h.01m8 5h.01"></path>
					<path class="cat-paws" d="M155 270c3-18 13-28 29-28s26 10 29 28m76 0c3-18 13-28 29-28 15 0 25 10 28 28m-162-27v17m134-17v17"></path>
				</svg>
				<div class="sticker">human<br />friendly<br /><b>✳</b></div>
			</div>
		</section>

		<div class="ticker" aria-hidden="true">
			<div>CONTRACTS <b>✦</b> PRIVACY <b>✦</b> DIGITAL PRODUCTS <b>✦</b> AI <b>✦</b> LEGAL OPS <b>✦</b> GOOD QUESTIONS <b>✦</b></div>
		</div>

		<section id="services" class="services section-shell section-space">
			<div class="section-heading">
				<div><p class="kicker">What I do</p><h2>Legal support that<br /><em>keeps you moving.</em></h2></div>
				<p>I work where law, technology and business overlap. Bring me in for one knotty question or make me part of the team.</p>
			</div>

			<div class="service-grid">
				{services.map((service) => (
					<article class="service-card">
						<div class="service-number">{service.number}</div>
						<h3>{service.title}</h3>
						<p>{service.text}</p>
						<ul>{service.tags.map((tag) => <li>{tag}</li>)}</ul>
						<span class="card-arrow">↗</span>
					</article>
				))}
			</div>
		</section>

		<section class="manifesto section-space">
			<svg class="manifesto-cat" viewBox="0 0 460 470" aria-hidden="true">
				<path class="manifesto-tail" d="M102 453C45 431 24 382 45 347c14-24 43-29 61-13 16 14 13 39-3 49-14 9-31 1-32-13"></path>
				<path class="manifesto-tail-fill" d="M102 453C45 431 24 382 45 347c14-24 43-29 61-13 16 14 13 39-3 49-14 9-31 1-32-13"></path>
				<path class="manifesto-body" d="M72 470c3-76 19-124 56-151-22-42-24-93-8-134L94 38l98 74c24-7 51-7 76 0l98-74-26 147c16 41 14 92-8 134 37 27 53 75 56 151H72Z"></path>
				<path class="manifesto-ear" d="m111 73 64 48-49 38Zm238 0-64 48 49 38Z"></path>
				<path class="manifesto-chest" d="M179 470c4-63 22-95 51-95s47 32 51 95"></path>
				<path class="manifesto-brow" d="M141 198c15-13 36-16 54-7m70 2c17-10 38-7 53 6"></path>
				<path class="manifesto-glasses" d="M126 225c0-28 20-47 48-47s48 19 48 47-20 47-48 47-48-19-48-47Zm112 0c0-28 20-47 48-47s48 19 48 47-20 47-48 47-48-19-48-47Zm-16-7c5-5 11-7 16 0"></path>
				<path class="manifesto-lens" d="M148 227c6-12 18-17 31-13 9 3 14 9 17 18m64 0c4-12 13-18 25-18 12 1 22 7 26 18"></path>
				<path class="manifesto-pupil" d="M176 219v21m110-21v21"></path>
				<path class="manifesto-muzzle" d="M194 280c10-10 23-10 36-2 13-8 26-8 36 2-1 27-13 40-36 40s-35-13-36-40Z"></path>
				<path class="manifesto-nose" d="m230 277-10 7 10 9 10-9Z"></path>
				<path class="manifesto-mouth" d="M230 293v7m0 0c-8 11-21 12-30 5m30-5c8 11 21 12 30 5"></path>
				<path class="manifesto-whiskers" d="m190 281-104-18m102 35-108 8m190-25 104-18m-102 35 108 8"></path>
				<path class="manifesto-paws" d="M121 470c3-34 20-53 48-53s45 19 48 53m26 0c3-34 20-53 48-53s45 19 48 53m-170-52v34m122-34v34"></path>
			</svg>
			<div class="manifesto-copy">
				<p class="kicker light">My point of view</p>
				<blockquote>“The best legal work doesn’t slow good ideas down. It gives them <em>somewhere to go.</em>”</blockquote>
			</div>
		</section>

		<section class="principles section-shell section-space">
			<p class="kicker">How I work</p>
			<div class="principle-list">
				{principles.map(([title, text], index) => (
					<article>
						<span>0{index + 1}</span>
						<h3>{title}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
		</section>

		<section id="about" class="about section-shell section-space">
			<div class="portrait-placeholder">
				<div class="portrait-label">YOUR PHOTO<br />GOES HERE</div>
				<svg viewBox="0 0 470 540" aria-hidden="true">
					<circle cx="235" cy="220" r="105"></circle>
					<path d="M86 540c10-128 61-200 149-200s139 72 149 200"></path>
				</svg>
				<div class="hello-badge">say hola!<br />↙</div>
			</div>
			<div class="about-copy">
				<p class="kicker">The human behind the work</p>
				<h2>Hi, I’m <span>[your name].</span><br />Lawyer, tech nerd,<br />question-asker.</h2>
				<p class="lead">I started Hola Gato to make legal support feel more useful, more collaborative and a lot less intimidating.</p>
				<p>I’ve spent my career close to technology and the people building it. I’m at my best translating complexity into a plan: listening carefully, finding the real issue and giving you advice your team can actually use.</p>
				<div class="personal-note">
					<span>OFF THE CLOCK</span>
					<p>Add a few human details here — the obscure hobby, current obsession or strong coffee opinion that makes this introduction sound like you.</p>
				</div>
			</div>
		</section>

		<section id="cv" class="cv section-space">
			<div class="section-shell cv-inner">
				<div class="cv-title">
					<p class="kicker light">The short version</p>
					<h2>Experience,<br /><em>minus the<br />stiff PDF.</em></h2>
					<a class="button button-yellow" href="mailto:hello@holagato.com?subject=Full%20CV%20please">Ask for the full CV ↗</a>
				</div>
				<div class="timeline">
					<div class="timeline-item current"><span>NOW</span><div><h3>Founder & legal consultant</h3><p>Hola Gato · Independent legal support for technology companies and product teams.</p></div></div>
					<div class="timeline-item"><span>ADD DATES</span><div><h3>Your most relevant role</h3><p>Add the company, title and one sentence about the kind of problems you solved.</p></div></div>
					<div class="timeline-item"><span>ADD DATES</span><div><h3>Your previous chapter</h3><p>Use this space for another role, consultancy, secondment or career highlight.</p></div></div>
					<div class="timeline-item"><span>EDUCATION</span><div><h3>Your degree & qualifications</h3><p>University, programme, specialist certificates and bar admission belong here.</p></div></div>
				</div>
			</div>
		</section>

		<section class="testimonials section-shell section-space">
			<div class="section-heading compact">
				<div><p class="kicker">Kind words</p><h2>Trusted to make<br /><em>things clearer.</em></h2></div>
				<p class="placeholder-note">These cards are ready for real client quotes. Replace the copy before publishing.</p>
			</div>
			<div class="quote-grid">
				<figure>
					<div class="quote-mark">“</div>
					<blockquote>Add a short testimonial about the way you work, the confidence you created or the problem you helped solve.</blockquote>
					<figcaption><b>Client name</b><span>Role · Company</span></figcaption>
				</figure>
				<figure>
					<div class="quote-mark">“</div>
					<blockquote>The strongest quotes are specific, human and no longer than two or three sentences.</blockquote>
					<figcaption><b>Client name</b><span>Role · Company</span></figcaption>
				</figure>
			</div>
		</section>

		<section id="contact" class="contact section-space">
			<div class="contact-spark" aria-hidden="true">✦</div>
			<p class="kicker">Got a legal knot?</p>
			<h2>Let’s untangle it.</h2>
			<p>Tell me what you’re building, where you’re stuck, or what keeps sliding to the bottom of the to-do list.</p>
			<a class="email-link" href="mailto:hello@holagato.com">hello@holagato.com <span>↗</span></a>
			<div class="contact-links">
				<span>LinkedIn · add your profile URL</span>
				<span>Based in Sweden · Working everywhere</span>
			</div>
		</section>
	</main>

	<footer>
		<a class="logo footer-logo" href="#top" aria-label="Hola Gato, back to top">
			<LogoMark />
			<span>hola gato</span>
		</a>
		<p>Legal consulting for curious companies.</p>
		<p>© {new Date().getFullYear()} Hola Gato</p>
	</footer>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { scroll-behavior: smooth; scroll-padding-top: 90px; }
	:global(body) { margin: 0; background: #fffaf3; color: #760031; font-family: Arial, Helvetica, sans-serif; overflow-x: hidden; }
	:global(a) { color: inherit; }
	:global(::selection) { background: #feec41; color: #760031; }

	.site-header { width: min(100% - 48px, 1240px); height: 88px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 10; }
	.logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 22px; font-weight: 900; letter-spacing: -1.2px; }
	.logo :global(.logo-mark) { flex: 0 0 auto; transition: transform .22s ease; }
	.logo:hover :global(.logo-mark) { transform: translateY(-2px) rotate(-4deg); }
	nav { display: flex; align-items: center; gap: 34px; font-size: 14px; font-weight: 700; }
	nav a { text-decoration: none; position: relative; }
	nav a:not(.nav-cta)::after { content: ''; height: 2px; width: 0; background: #d51c39; position: absolute; bottom: -5px; left: 0; transition: width .2s ease; }
	nav a:hover::after { width: 100%; }
	.nav-cta { background: #760031; color: #fff; padding: 13px 19px; border-radius: 999px; }
	.nav-cta span { margin-left: 8px; }

	.section-shell { width: min(100% - 48px, 1240px); margin-inline: auto; }
	.section-space { padding-top: 120px; padding-bottom: 120px; }
	.hero { min-height: calc(100vh - 88px); display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 40px; padding-top: 40px; padding-bottom: 90px; }
	.eyebrow, .kicker { text-transform: uppercase; font-size: 12px; font-weight: 900; letter-spacing: 2px; }
	.eyebrow { display: flex; align-items: center; gap: 11px; }
	.eyebrow span { width: 8px; height: 8px; background: #d51c39; border-radius: 50%; box-shadow: 0 0 0 5px rgba(213,28,57,.13); }
	h1, h2, blockquote { font-family: Georgia, 'Times New Roman', serif; letter-spacing: -.055em; }
	h1 { font-size: clamp(66px, 7.2vw, 112px); line-height: .84; margin: 34px 0; font-weight: 500; }
	h1 em, h2 em, blockquote em { color: #d51c39; font-weight: 500; }
	.hero-intro { max-width: 600px; font-size: clamp(18px, 1.7vw, 23px); line-height: 1.45; }
	.hero-actions { display: flex; align-items: center; gap: 30px; margin-top: 42px; }
	.button { display: inline-flex; align-items: center; gap: 24px; text-decoration: none; padding: 17px 23px; border-radius: 999px; font-weight: 800; font-size: 14px; transition: transform .2s ease, box-shadow .2s ease; }
	.button:hover { transform: translateY(-3px) rotate(-1deg); box-shadow: 5px 7px 0 #ff6060; }
	.button-dark { background: #760031; color: #fff; }
	.text-link { font-weight: 800; text-underline-offset: 5px; }
	.text-link span { margin-left: 8px; }

	.hero-art { min-height: 590px; position: relative; display: grid; place-items: center; }
	.hero-art::before { content: ''; width: 82%; aspect-ratio: 1; border-radius: 50%; background: #feec41; position: absolute; }
	.orbit { position: absolute; border: 2px solid #d51c39; border-radius: 50%; z-index: 0; opacity: .7; }
	.orbit-one { width: 98%; height: 53%; transform: rotate(34deg); }
	.orbit-two { width: 95%; height: 42%; transform: rotate(-27deg); }
	.hero-cat { width: 95%; position: absolute; bottom: 3%; right: -3%; z-index: 2; overflow: visible; filter: drop-shadow(7px 9px 0 rgba(213, 28, 57, .18)); transition: transform .3s ease; }
	.hero-art:hover .hero-cat { transform: translateY(-4px) rotate(.5deg); }
	.cat-body { fill: #ff6060; stroke: #760031; stroke-width: 5; stroke-linejoin: round; }
	.cat-tail, .cat-tail-fill { fill: none; stroke-linecap: round; }
	.cat-tail { stroke: #760031; stroke-width: 30; }
	.cat-tail-fill { stroke: #ff6060; stroke-width: 19; }
	.cat-ear { fill: #feec41; stroke: #760031; stroke-width: 4; stroke-linejoin: round; }
	.cat-chest { fill: #feec41; stroke: #760031; stroke-width: 5; stroke-linecap: round; }
	.cat-muzzle { fill: #ff897e; }
	.cat-eye-socket { fill: #fffaf3; stroke: #760031; stroke-width: 4; stroke-linejoin: round; }
	.cat-pupil, .cat-nose { fill: #760031; }
	.cat-detail { fill: none; stroke: #760031; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
	.whiskers { stroke-width: 3; }
	.cat-freckles { fill: none; stroke: #760031; stroke-width: 5; stroke-linecap: round; }
	.cat-paws { fill: none; stroke: #760031; stroke-width: 4; stroke-linecap: round; }
	.legal-card { position: absolute; z-index: 3; width: 190px; height: 245px; background: white; border: 3px solid #760031; padding: 18px; transform: rotate(-8deg); left: 1%; bottom: 5%; box-shadow: 10px 10px 0 #d51c39; }
	.card-top { display: flex; justify-content: space-between; font-size: 9px; font-weight: 900; letter-spacing: 1px; border-bottom: 2px solid #760031; padding-bottom: 10px; }
	.card-lines { display: grid; gap: 10px; margin-top: 19px; }
	.card-lines i { height: 4px; background: #760031; display: block; opacity: .7; }
	.card-lines i:nth-child(2), .card-lines i:nth-child(5) { width: 70%; }
	.approved { position: absolute; right: 12px; bottom: 14px; border: 3px solid #d51c39; color: #d51c39; border-radius: 50%; padding: 14px 9px; transform: rotate(12deg); font-size: 11px; text-align: center; font-weight: 900; }
	.sticker { position: absolute; z-index: 4; right: 0; top: 9%; width: 120px; aspect-ratio: 1; display: grid; place-content: center; border-radius: 50%; background: #d51c39; color: #fff; text-align: center; text-transform: uppercase; font-size: 12px; font-weight: 900; letter-spacing: 1px; transform: rotate(10deg); border: 2px solid #760031; box-shadow: 5px 5px 0 #760031; }
	.sticker b { color: #feec41; font-size: 22px; line-height: .7; }

	.ticker { background: #760031; color: #fff; padding: 16px 0; overflow: hidden; transform: rotate(-1deg) scale(1.02); }
	.ticker div { font-size: 13px; font-weight: 900; letter-spacing: 1.5px; word-spacing: 18px; white-space: nowrap; text-align: center; }
	.ticker b { color: #feec41; }

	.section-heading { display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: 50px; margin-bottom: 65px; }
	.section-heading h2, .about-copy h2, .cv-title h2 { font-size: clamp(48px, 5.8vw, 82px); line-height: .98; font-weight: 500; margin: 20px 0 0; }
	.section-heading > p { font-size: 19px; line-height: 1.55; max-width: 410px; justify-self: end; margin: 0 0 6px; }
	.service-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
	.service-card { position: relative; min-height: 340px; padding: 32px; border: 2px solid #760031; border-radius: 2px; overflow: hidden; background: #fffaf3; transition: transform .25s ease, background .25s ease, color .25s ease; }
	.service-card:nth-child(2), .service-card:nth-child(3) { background: #ff6060; }
	.service-card:hover { transform: translateY(-7px); background: #760031; color: #fff; }
	.service-number { font-size: 12px; font-weight: 900; border: 1px solid currentColor; border-radius: 50%; width: 38px; height: 38px; display: grid; place-items: center; }
	.service-card h3 { font-family: Georgia, serif; font-size: 36px; letter-spacing: -.03em; margin: 52px 0 16px; font-weight: 500; }
	.service-card > p { max-width: 480px; font-size: 17px; line-height: 1.5; }
	.service-card ul { list-style: none; display: flex; gap: 7px; flex-wrap: wrap; padding: 0; margin: 26px 0 0; }
	.service-card li { border: 1px solid currentColor; border-radius: 999px; padding: 6px 10px; font-size: 11px; font-weight: 800; }
	.card-arrow { position: absolute; right: 28px; top: 28px; font-size: 30px; }

	.manifesto { min-height: 610px; background: #760031; color: #fff; display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; padding-left: max(24px, calc((100vw - 1240px) / 2)); padding-right: max(24px, calc((100vw - 1240px) / 2)); overflow: hidden; }
	.manifesto-cat { align-self: end; width: min(100%, 460px); height: auto; overflow: visible; filter: drop-shadow(-10px 10px 0 rgba(0, 0, 0, .16)); }
	.manifesto-body { fill: #ff6060; stroke: #fffaf3; stroke-width: 6; stroke-linejoin: round; }
	.manifesto-tail, .manifesto-tail-fill { fill: none; stroke-linecap: round; }
	.manifesto-tail { stroke: #fffaf3; stroke-width: 34; }
	.manifesto-tail-fill { stroke: #ff6060; stroke-width: 22; }
	.manifesto-ear, .manifesto-chest { fill: #feec41; stroke: #760031; stroke-width: 5; stroke-linejoin: round; }
	.manifesto-chest { stroke-linecap: round; }
	.manifesto-glasses { fill: #fffaf3; stroke: #760031; stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; }
	.manifesto-brow, .manifesto-lens, .manifesto-pupil, .manifesto-mouth, .manifesto-whiskers, .manifesto-paws { fill: none; stroke: #760031; stroke-linecap: round; stroke-linejoin: round; }
	.manifesto-brow { stroke-width: 7; }
	.manifesto-lens { stroke: #ff6060; stroke-width: 5; opacity: .65; }
	.manifesto-pupil { stroke-width: 10; }
	.manifesto-muzzle { fill: #ff897e; }
	.manifesto-nose { fill: #760031; }
	.manifesto-mouth { stroke-width: 5; }
	.manifesto-whiskers { stroke-width: 4; }
