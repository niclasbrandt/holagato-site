---
// STARTSIDA (svenska)
import PageLayout from '../../layouts/PageLayout.astro';
import HeroArt from '../../components/HeroArt.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import AudienceGrid from '../../components/AudienceGrid.astro';
import Testimonials from '../../components/Testimonials.astro';
---
<PageLayout
	lang="sv"
	page="home"
	title="Hola Gato – Juristen som får saker att lyfta"
	description="Oberoende juridisk strategi och förändring för ledningsgrupper och små juristteam – avtal, bolagsfrågor, GDPR och AI, med juridiskt omdöme längs vägen."
>
	<section class="hero section-shell">
		<div class="hero-copy">
			<p class="eyebrow"><span></span> En jurist som hellre bygger än bromsar</p>
			<h1>Juristen som får saker<br /><em>att lyfta.</em></h1>
			<p class="hero-intro">Avtal, bolagsfrågor, GDPR och AI. Jag har nyfikenheten att ställa rätt frågor och det juridiska omdömet att agera på svaren – längs vägen, inte i efterhand.</p>
			<div class="hero-actions">
				<a class="button button-dark" href="#contact">Berätta vad som är på gång <span>↘︎</span></a>
				<a class="text-link" href="#services">Så kan jag hjälpa er <span>↓︎</span></a>
			</div>
		</div>
		<HeroArt />
	</section>

	<div class="ticker" aria-hidden="true">
		<div>AVTAL <b>✦︎</b> BOLAGSRÄTT <b>✦︎</b> GDPR <b>✦︎</b> AI-STYRNING <b>✦︎</b> FÖRHANDLING <b>✦︎</b> LEGAL OPS <b>✦︎</b> FÖRÄNDRINGSLEDNING <b>✦︎</b></div>
	</div>

	<section id="services" class="services section-shell section-space">
		<div class="section-heading">
			<div><p class="kicker">Det här gör jag</p><h2>Börja med<br /><em>din fråga.</em></h2></div>
			<p>Det här är frågorna jag oftast får. Hitta din, så vet vi var vi börjar.</p>
		</div>
		<ServiceCards lang="sv" />
		<div class="section-more">
			<a class="button button-dark" href="/sv/priser">Se priser <span>↗︎</span></a>
		</div>
	</section>

	<AudienceGrid lang="sv" />
	<Testimonials lang="sv" />

	<section class="case-studies section-shell section-space">
		<div class="section-heading compact">
			<div><p class="kicker">Uppdrag</p><h2>Bevis,<br /><em>inte löften.</em></h2></div>
			<p>Läs om uppdrag inom AI, legal ops, compliance, ledarskap och förhandling. Beskrivningarna finns på engelska.</p>
		</div>
		<a class="button button-dark" href="/cases" hreflang="en">Se alla uppdrag (på engelska) <span>↗︎</span></a>
	</section>
</PageLayout>
