---
// Case studies – English only. Content in data/cases.ts
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CaseCard from '../components/CaseCard.astro';
import { featuredCases, caseGroups, moreCaseGroups } from '../data/cases';
const groups = [...caseGroups, ...moreCaseGroups];
---
<PageLayout lang="en" page="cases" title="Case studies – Hola Gato" description="Real engagements in AI, legal ops, compliance, leadership and negotiation – organized by the kind of problem they solve.">
	<PageIntro kicker="Case studies" title="Proof," em="not promises." text="A mix of real engagements and one worked example, organized by the kind of problem they solve. Click a card to read more.">
		<nav class="case-filter" aria-label="Jump to theme">
			{groups.map((g) => <a href={`#${g.heading.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{g.heading}</a>)}
		</nav>
	</PageIntro>
	<section class="case-studies section-shell section-space">
		<div class="case-featured-grid">
			{featuredCases.map((item) => <CaseCard item={item} featured />)}
		</div>
		{groups.map((group) => (
			<div class="case-group" id={group.heading.toLowerCase().replace(/[^a-z]+/g, '-')}>
				<p class="case-group-heading">{group.heading}</p>
				<div class="case-grid">
					{group.cases.map((item) => <CaseCard item={item} />)}
				</div>
			</div>
		))}
	</section>
</PageLayout>
